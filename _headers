/*
  # ── 防止 MIME 类型嗅探攻击 ──
  X-Content-Type-Options: nosniff

  # ── 防止点击劫持（禁止被嵌入 iframe）──
  X-Frame-Options: DENY

  # ── 控制 Referer 信息，防止泄露来源 ──
  Referrer-Policy: strict-origin-when-cross-origin

  # ── 禁用不需要的浏览器功能，防止隐私泄露 ──
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), interest-cohort=()

  # ── XSS 防护（现代浏览器内置，旧浏览器兜底）──
  X-XSS-Protection: 1; mode=block

  # ── 内容安全策略（CSP）：只允许加载本站资源 ──
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://pagead2.googlesyndication.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://unpkg.com; frame-src https://googleads.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

  # ── 强制 HTTPS，1年内不允许 HTTP 访问 ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── 隐藏服务器信息 ──
  Server: .

  # ── 防止浏览器缓存敏感页面 ──
  X-DNS-Prefetch-Control: off

  # ── 跨域资源策略 ──
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Opener-Policy: unsafe-none
  Cross-Origin-Embedder-Policy: unsafe-none

# ── 图片和静态资源：长期缓存 ──
/images/*
  Cache-Control: public, max-age=31536000, immutable

/Items/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
